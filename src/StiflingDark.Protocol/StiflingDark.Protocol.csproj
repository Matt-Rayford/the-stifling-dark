<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Matches the engine, so a Unity client can import the wire types as-is. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>StiflingDark.Protocol</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\StiflingDark.Engine\StiflingDark.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

</Project>
